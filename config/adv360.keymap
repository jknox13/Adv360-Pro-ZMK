#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        serbian_zh: serbian_zh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(V) &kp Z>;
            label = "SERBIAN_ZH";
        };

        serbian_dj: serbian_dj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(L) &kp D>;
            label = "SERBIAN_DJ";
        };

        serbian_sh: serbian_sh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(V) &kp S>;
            label = "SERBIAN_SH";
        };

        serbian_ch: serbian_ch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(V) &kp C>;
            label = "SERBIAN_CH";
        };

        serbian_chj: serbian_chj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(E) &kp C>;
            label = "SERBIAN_CHJ";
        };

        french_cs: french_cs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(C) &kp C>;
            label = "FRENCH_CS";
        };

        french_a_grave: french_a_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(GRAVE) &kp A>;
            label = "FRENCH_A_GRAVE";
        };

        french_e_grave: french_e_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(GRAVE) &kp E>;
            label = "FRENCH_E_GRAVE";
        };

        french_u_grave: french_u_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(GRAVE) &kp U>;
            label = "FRENCH_U_GRAVE";
        };

        french_e_acute: french_e_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(E) &kp E>;
            label = "FRENCH_E_ACUTE";
        };

        euro_symbol: euro_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(RS(NUMBER_2))>;
            label = "EURO_SYMBOL";
        };

        french_i_trema: french_i_trema {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(U) &kp I>;
            label = "FRENCH_I_TREMA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default_layer";
            bindings = <
&none    &kp N1            &kp N2   &kp N3    &kp N4     &kp N5  &none                                                                                             &mo 6            &kp N6  &kp N7   &kp N8     &kp N9   &kp N0             &none
&kp TAB  &kp Q             &kp W    &kp F     &kp P      &kp B   &none                                                                                             &none            &kp J   &kp L    &kp U      &kp Y    &kp SEMICOLON      &none
&kp ESC  &mt LEFT_SHIFT A  &lt 4 R  &lt 3 S   &lt 2 T    &kp G   &to 4                &kp LGUI          &kp CAPS      &kp C_BACKLIGHT_TOGGLE  &kp RGUI             &none            &kp M   &lt 2 N  &kp E      &kp I    &mt RIGHT_SHIFT O  &none
&none    &kp Z             &kp X    &kp C     &lt 1 D    &kp V                                          &kp HOME      &kp PG_UP                                                     &kp K   &lt 1 H  &kp COMMA  &kp DOT  &kp FSLH           &none
&to 5    &none             &none    &kp LEFT  &kp RIGHT          &mt LCTRL BACKSPACE  &mt LEFT_ALT TAB  &kp END       &kp PG_DN               &mt RIGHT_ALT ENTER  &mt RCTRL SPACE          &kp UP   &kp DOWN   &none    &none              &tog 7
            >;
        };

        lang_mac {
            display-name = "lang_mac";
            bindings = <
&none  &none            &none        &none        &none         &none  &none                                       &none   &none  &none  &none            &none            &none  &none
&none  &none            &none        &none        &none         &none  &none                                       &none   &none  &none  &french_u_grave  &none            &none  &none
&none  &french_a_grave  &none        &french_cs   &serbian_chj  &none  &none   &trans  &trans      &trans  &trans  &none   &none  &none  &french_e_acute  &french_i_trema  &none  &none
&none  &serbian_zh      &serbian_sh  &serbian_ch  &serbian_dj   &none                  &trans      &trans                  &none  &none  &french_e_grave  &none            &none  &none
&none  &none            &none        &none        &none                &trans  &trans  &trans      &trans  &trans  &trans         &none  &none            &none            &none  &none
            >;
        };

        symbols {
            display-name = "symbols";
            bindings = <
&none  &none         &none         &none         &none         &none          &none                                       &none   &none          &none          &none         &none          &none         &none
&none  &none         &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(DLLR)  &kp LS(PRCNT)  &none                                       &none   &kp LS(CARET)  &kp LS(AMPS)   &kp LS(STAR)  &kp LS(POUND)  &none         &none
&none  &kp BSLH      &kp LS(LPAR)  &kp LS(RPAR)  &kp SQT       &kp GRAVE      &none   &trans  &trans      &trans  &trans  &none   &kp LS(PIPE)   &kp MINUS      &kp EQUAL     &kp LS(PLUS)   &kp LS(EXCL)  &none
&none  &euro_symbol  &kp LBKT      &kp RBKT      &kp LS(DQT)   &kp LS(AT)                     &trans      &trans                  &kp LS(TILDE)  &kp LS(UNDER)  &kp LS(LT)    &kp LS(GT)     &trans        &none
&none  &none         &none         &none         &none                        &trans  &trans  &trans      &trans  &trans  &trans                 &none          &none         &none          &none         &none
            >;
        };

        direction {
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none           &none           &none         &none            &none
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none           &none           &none         &none            &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&none  &none  &none  &none  &none  &none                &none      &none                &none  &none           &none           &none         &none            &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none         &none           &none           &none         &none            &none
            >;

            label = "direction";
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none   &none  &none  &none     &none      &none  &trans                                      &none   &none            &none      &none      &none       &none          &none
&trans  &none  &none  &none     &none      &none  &none                                       &none   &kp KP_ASTERISK  &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_EQUAL   &none
&trans  &none  &none  &none     &none      &none  &to 0   &trans  &trans      &trans  &trans  &none   &kp KP_PLUS      &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_N0      &none
&none   &none  &none  &none     &none      &none                  &trans      &trans                  &kp KP_MINUS     &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp KP_DIVIDE  &none
&none   &none  &none  &kp LEFT  &kp RIGHT         &trans  &trans  &trans      &trans  &trans  &trans                   &kp UP     &kp DOWN   &kp KP_DOT  &none          &none
            >;

            label = "keypad";
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &none                                  &none  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&none   &none   &none   &none   &none   &none   &none                                  &none  &none   &none   &none   &none    &none    &none
&none   &none   &none   &none   &none   &none   &none  &none  &none      &none  &none  &none  &none   &none   &none   &none    &none    &none
&none   &none   &none   &none   &none   &none                 &none      &none                &none   &none   &none   &none    &none    &none
&to 0   &none   &none   &none   &none           &none  &none  &none      &none  &none  &none          &none   &none   &none    &none    &none
            >;

            label = "fn";
        };

        mod {
            display-name = "mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        none {
            display-name = "symbols";
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none      &none                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none         &none  &none  &none  &none  &tog 7
            >;

            label = "none";
        };
    };
};
