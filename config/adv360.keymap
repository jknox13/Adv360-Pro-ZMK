#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        serbian_zh: serbian_zh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(V) &kp Z>;
            label = "SERBIAN_ZH";
        };

        serbian_dj: serbian_dj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(L) &kp D>;
            label = "SERBIAN_DJ";
        };

        serbian_sh: serbian_sh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(V) &kp S>;
            label = "SERBIAN_SH";
        };

        serbian_ch: serbian_ch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(V) &kp C>;
            label = "SERBIAN_CH";
        };

        serbian_chj: serbian_chj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(E) &kp C>;
            label = "SERBIAN_CHJ";
        };

        french_cs: french_cs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(C) &kp C>;
            label = "FRENCH_CS";
        };

        french_a_grave: french_a_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(GRAVE) &kp A>;
            label = "FRENCH_A_GRAVE";
        };

        french_e_grave: french_e_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(GRAVE) &kp E>;
            label = "FRENCH_E_GRAVE";
        };

        french_u_grave: french_u_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(GRAVE) &kp U>;
            label = "FRENCH_U_GRAVE";
        };

        french_e_acute: french_e_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(E) &kp E>;
            label = "FRENCH_E_ACUTE";
        };

        euro_symbol: euro_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(RS(NUMBER_2))>;
            label = "EURO_SYMBOL";
        };

        french_i_trema: french_i_trema {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(U) &kp I>;
            label = "FRENCH_I_TREMA";
        };

        guillemet_guache: guillemet_guache {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(BACKSLASH)>;
            label = "GUILLEMET_GUACHE";
        };

        guillemets_droite: guillemets_droite {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(RS(BACKSLASH))>;
            label = "GUILLEMETS_DROITE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default_layer";
            bindings = <
&none    &kp N1            &kp N2   &kp N3    &kp N4     &kp N5  &to 7                                                                                             &mo 6            &kp N6  &kp N7   &kp N8     &kp N9   &kp N0             &kp C_SLEEP
&kp TAB  &kp Q             &kp W    &kp F     &kp P      &kp B   &none                                                                                             &none            &kp J   &kp L    &kp U      &kp Y    &kp SEMICOLON      &none
&kp ESC  &mt LEFT_SHIFT A  &lt 4 R  &lt 3 S   &lt 2 T    &kp G   &none                &kp LGUI          &kp CAPS      &kp C_BACKLIGHT_TOGGLE  &mt RGUI ESC         &none            &kp M   &lt 2 N  &kp E      &kp I    &mt RIGHT_SHIFT O  &none
&none    &kp Z             &kp X    &kp C     &lt 1 D    &kp V                                          &kp HOME      &kp PG_UP                                                     &kp K   &lt 1 H  &kp COMMA  &kp DOT  &kp FSLH           &none
&to 5    &none             &none    &kp LEFT  &kp RIGHT          &mt LCTRL BACKSPACE  &mt LEFT_ALT TAB  &kp END       &kp PG_DN               &mt RIGHT_ALT ENTER  &mt RCTRL SPACE          &kp UP   &kp DOWN   &none    &none              &tog 8
            >;
        };

        lang_mac {
            display-name = "lang_mac";
            bindings = <
&none  &none            &none        &none        &none         &none  &none                                       &none   &none              &none               &none            &none            &none  &none
&none  &none            &none        &none        &none         &none  &none                                       &none   &none              &none               &french_u_grave  &none            &none  &none
&none  &french_a_grave  &none        &french_cs   &serbian_chj  &none  &none   &trans  &trans      &trans  &trans  &none   &guillemet_guache  &guillemets_droite  &french_e_acute  &french_i_trema  &none  &none
&none  &serbian_zh      &serbian_sh  &serbian_ch  &serbian_dj   &none                  &trans      &trans                  &none              &none               &french_e_grave  &none            &none  &none
&none  &none            &none        &none        &none                &trans  &trans  &trans      &trans  &trans  &trans                     &none               &none            &none            &none  &none
            >;
        };

        symbols {
            display-name = "symbols";
            bindings = <
&none  &none         &none         &none         &none         &none          &none                                       &none   &none          &none          &none         &none          &none         &none
&none  &none         &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(DLLR)  &kp LS(PRCNT)  &none                                       &none   &kp LS(CARET)  &kp LS(AMPS)   &kp LS(STAR)  &kp LS(POUND)  &none         &none
&none  &kp BSLH      &kp LS(LPAR)  &kp LS(RPAR)  &kp SQT       &kp GRAVE      &none   &trans  &trans      &trans  &trans  &none   &kp LS(PIPE)   &kp MINUS      &kp EQUAL     &kp LS(PLUS)   &kp LS(EXCL)  &none
&none  &euro_symbol  &kp LBKT      &kp RBKT      &kp LS(DQT)   &kp LS(AT)                     &trans      &trans                  &kp LS(TILDE)  &kp LS(UNDER)  &kp LS(LT)    &kp LS(GT)     &trans        &none
&none  &none         &none         &none         &none                        &trans  &trans  &trans      &trans  &trans  &trans                 &none          &none         &none          &none         &none
            >;
        };

        direction {
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none           &none           &none         &none            &none
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none           &none           &none         &none            &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&none  &none  &none  &none  &none  &none                &none      &none                &none  &none           &none           &none         &none            &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none         &none           &none           &none         &none            &none
            >;

            label = "direction";
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none  &none  &none  &none     &none      &none  &none                                       &none   &none         &none         &none         &none         &none         &none
&none  &none  &none  &none     &none      &none  &none                                       &none   &kp ASTERISK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL     &none
&none  &none  &none  &none     &none      &none  &none   &trans  &trans      &trans  &trans  &none   &kp PLUS      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0  &none
&none  &none  &none  &none     &none      &none                  &trans      &trans                  &kp MINUS     &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp SLASH     &none
&none  &none  &none  &kp LEFT  &kp RIGHT         &trans  &trans  &trans      &trans  &trans  &trans                &kp UP        &kp DOWN      &kp DOT       &none         &none
            >;

            label = "keypad";
        };

        fn {
            display-name = "Fn";
            bindings = <
&none  &kp C_MUTE      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none                                                    &none  &none  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_STOP  &none
&none  &none           &none              &none            &none                 &none                 &none                                                    &none  &none  &kp F7      &kp F8            &kp F9      &kp F11     &none
&none  &kp LEFT_SHIFT  &none              &kp LCTRL        &kp LEFT_ALT          &none                 &none  &kp LEFT_CONTROL  &kp LEFT_ALT      &none  &none  &none  &none  &kp F4      &kp F5            &kp F6      &kp F10     &none
&none  &none           &none              &none            &none                 &none                                          &none             &none                &none  &kp F1      &kp F2            &kp F3      &kp F12     &none
&to 0  &none           &none              &none            &none                                       &none  &none             &none             &none  &none  &none         &none       &none             &none       &none       &none
            >;

            label = "fn";
        };

        mod {
            display-name = "mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        qwerty {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3          &kp N4           &kp N5  &to 0                                                         &mo 6      &kp N6  &kp N7        &kp N8          &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E           &kp R            &kp T   &none                                                         &none      &kp Y   &kp U         &kp I           &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D           &kp F            &kp G   &none     &kp LCTRL   &kp LALT      &kp RCTRL      &kp RALT   &none      &kp H   &kp J         &kp K           &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z      &kp X     &kp C           &kp V            &kp B                         &kp HOME      &kp PAGE_UP                          &kp N   &kp M         &kp COMMA       &kp DOT   &kp FSLH  &kp RSHFT
&none      &kp GRAVE  &kp CAPS  &kp LEFT_ARROW  &kp RIGHT_ARROW          &kp BSPC  &kp DELETE  &kp END       &kp PAGE_DOWN  &kp ENTER  &kp SPACE          &kp UP_ARROW  &kp DOWN_ARROW  &kp LBKT  &kp RBKT  &none
            >;
        };

        none {
            display-name = "symbols";
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none      &none                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none         &none  &none  &none  &none  &tog 8
            >;

            label = "none";
        };
    };
};
